meta {
  name: 02 Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "name": "{{name}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body?.token) {
    bru.setEnvVar("token", body.token);
  }
  if (body?.user?.apiKey) {
    bru.setEnvVar("apiKey", body.user.apiKey);
  }
}
